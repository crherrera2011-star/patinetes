# Copia este archivo como .env y ajusta los valores.
# Solo las variables con prefijo VITE_ llegan al navegador.

# --- Supabase ---
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_publica

# --- Identidad del sitio ---
VITE_SITE_URL=https://patinetes-electricos.es
VITE_CONTACT_EMAIL=hola@patinetes-electricos.es

# --- Amazon Afiliados ---
# Tu tag de Amazon.es (termina en -21).
VITE_AMAZON_TAG=tucodigo-21

# --- Solo scripts (NUNCA con prefijo VITE_) ---
# SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key
